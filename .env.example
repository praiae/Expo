# Desenvolvimento local: copie para .env (opcional). Sem DATABASE_URL usa-se uma base Postgres embutida em data/pglite.
#
# No Netlify defina estas variáveis em Project configuration → Environment variables:
#   APP_SECRET       (obrigatória) chave de encriptação: 64 caracteres hex, ex.: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
#   ADMIN_PASSWORD   (obrigatória no 1.º arranque) palavra-passe do administrador inicial
#   ADMIN_EMAIL      (opcional) e-mail do administrador inicial
#   SITE_URL         (opcional) domínio próprio, ex.: https://expoconnect.ao (lido no build)
# A ligação à Netlify Database é obtida automaticamente (não é preciso definir nada).

APP_SECRET=
ADMIN_EMAIL=admin@expoconnect.ao
ADMIN_PASSWORD=
# DATABASE_URL=postgres://utilizador:senha@host/base
