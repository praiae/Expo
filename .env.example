# Copie para .env e ajuste (lido pelos scripts npm). SITE_URL e ALLOWED_DOMAINS ficam fixos no build: refaça o build se mudarem.
SITE_URL=https://expoconnect.ao
ALLOWED_DOMAINS=expoconnect.ao,www.expoconnect.ao
HOST=0.0.0.0
PORT=4321
# Chave mestra de encriptação (64 caracteres hex). Se omitida, é gerada em data/secret.key.
APP_SECRET=
# Conta de administrador criada no primeiro arranque.
ADMIN_EMAIL=admin@expoconnect.ao
ADMIN_PASSWORD=
DATA_DIR=./data
