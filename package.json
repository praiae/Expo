{
  "name": "expo-connect-angola",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de acessibilidade e inclusão — estatística, procura e prioridade.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "migracao": "node scripts/gerar-migracao.js"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.9",
    "@netlify/database": "2.0.1",
    "astro": "7.3.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
