---
// Colunas verticais para séries temporais (registos por mês).
interface Props { dados: { nome: string; valor: number }[]; rotulo?: string; }
const { dados = [], rotulo = 'Série temporal' } = Astro.props;
const max = Math.max(1, ...dados.map((d) => d.valor));
const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const rot = (ym: string) => { const [a, m] = ym.split('-'); return `${MESES[Number(m) - 1] ?? m} ${a.slice(2)}`; };
---
{dados.length === 0 ? <p class="vazio">Ainda sem registos.</p> : (
  <ol class="colunas" aria-label={rotulo}>
    {dados.map((d) => (
      <li>
        <span class="c-valor">{d.valor}</span>
        <span class="c-barra" style={`height:${Math.max(2, (d.valor / max) * 100)}%`} aria-hidden="true"></span>
        <span class="c-nome">{rot(d.nome)}</span>
      </li>
    ))}
  </ol>
)}

<style>
  .colunas { list-style: none; margin: 0; padding: 0; display: flex; align-items: flex-end; gap: 6px; height: 200px; }
  li { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; min-width: 0; gap: 4px; }
  .c-barra { width: 100%; max-width: 40px; background: var(--series-1); border-radius: 4px 4px 0 0; }
  .c-valor { font-size: .75rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .c-nome { font-size: .7rem; color: var(--muted); white-space: nowrap; }
</style>
