---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Assistente from '../components/Assistente.astro';

interface Props { title?: string; description?: string; transicoes?: boolean; }
const {
  title = 'Expo Connect Angola',
  description = 'Plataforma de acessibilidade e inclusão: estatística, procura e prioridade para pessoas com deficiência, idosos e mobilidade reduzida.',
  transicoes = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="pt-AO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <!-- Aplicação instalável (PWA) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2f63e0" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Expo Connect" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo.png', canonical)} />
    <meta property="og:locale" content="pt_AO" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Aplica preferências de tema/contraste/tamanho antes do primeiro desenho (sem "flash").
      (function () {
        function aplicar() {
          var d = document.documentElement;
          try {
            var t = localStorage.getItem('ec-tema'); if (t) d.dataset.theme = t;
            var c = localStorage.getItem('ec-contraste'); if (c) d.dataset.contrast = c;
            var f = localStorage.getItem('ec-fonte'); if (f) d.dataset.fonte = f;
          } catch (e) {}
        }
        aplicar();
        document.addEventListener('astro:after-swap', aplicar);
      })();
    </script>
    {transicoes && <ClientRouter />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    <slot />
    <Assistente />
    <script is:inline>
      // Regista o service worker (aplicação instalável e página offline).
      if ('serviceWorker' in navigator) {
        addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
      }
    </script>
  </body>
</html>
