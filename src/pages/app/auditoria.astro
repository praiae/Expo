---
import App from '../../layouts/App.astro';
import { db } from '../../lib/db.js';

const q = (Astro.url.searchParams.get('q') || '').trim();
const POR_PAGINA = 100;
const pagina = Math.max(1, parseInt(Astro.url.searchParams.get('p') || '1', 10) || 1);
const where = q ? `WHERE a.acao LIKE ?1 OR a.alvo LIKE ?1 OR u.nome LIKE ?1 OR u.email LIKE ?1` : '';
const args = q ? [`%${q}%`] : [];
const linhas = db().prepare(`SELECT a.*, u.nome, u.email FROM auditoria a LEFT JOIN utilizadores u ON u.id = a.utilizador_id
  ${where} ORDER BY a.id DESC LIMIT ${POR_PAGINA + 1} OFFSET ${(pagina - 1) * POR_PAGINA}`).all(...args);
const haMais = linhas.length > POR_PAGINA;
const qs = (p: number) => `?${new URLSearchParams({ ...(q ? { q } : {}), p: String(p) })}`;
---
<App title="Auditoria de acessos" ativo="auditoria" subtitulo="Registo de inícios de sessão, consultas de dados sensíveis, exportações e alterações administrativas.">
  <form method="get" class="filtros card" role="search">
    <label class="field col-2"><span>Pesquisar</span><input type="search" name="q" value={q} placeholder="Acção, utilizador ou alvo" /></label>
    <div class="filtros-accoes"><button class="btn" type="submit">Filtrar</button><a class="btn btn--ghost" href="/app/auditoria">Limpar</a></div>
  </form>
  <div class="tabela-wrap">
    <table>
      <thead><tr><th>Data (UTC)</th><th>Utilizador</th><th>Acção</th><th>Alvo</th><th>IP</th></tr></thead>
      <tbody>
        {linhas.slice(0, POR_PAGINA).map((a) => (
          <tr>
            <td class="mono">{a.criado_em}</td>
            <td>{a.nome ?? '—'}<br /><span class="hint">{a.email ?? ''}</span></td>
            <td>{a.acao}</td>
            <td class="hint" style="max-width:360px;overflow-wrap:anywhere">{a.alvo?.startsWith('pessoa:') ? <a href={`/app/beneficiarios/${a.alvo.slice(7)}`}>{a.alvo}</a> : (a.alvo ?? '')}</td>
            <td class="mono">{a.ip ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <nav class="paginacao" aria-label="Paginação">
    <span class="hint">Página {pagina}</span>
    <span class="linha-accoes">
      {pagina > 1 && <a class="btn btn--ghost btn--sm" href={qs(pagina - 1)}>← Mais recentes</a>}
      {haMais && <a class="btn btn--ghost btn--sm" href={qs(pagina + 1)}>Mais antigos →</a>}
    </span>
  </nav>
</App>
