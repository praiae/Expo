---
import App from '../../layouts/App.astro';
import { db, auditar, exportarTudo } from '../../lib/db.js';

const user = Astro.locals.user;
if (Astro.request.method === 'POST') {
  const dados = await exportarTudo();
  await auditar(user, 'Cópia de segurança descarregada', null, Astro.locals.ip);
  const data = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
  return new Response(JSON.stringify(dados), {
    headers: { 'Content-Type': 'application/json; charset=utf-8', 'Content-Disposition': `attachment; filename="expo-connect-${data}.json"` },
  });
}
const n = await db.get(`SELECT (SELECT COUNT(*) FROM pessoas) p, (SELECT COUNT(*) FROM utilizadores) u,
  (SELECT COUNT(*) FROM auditoria) a, pg_size_pretty(pg_database_size(current_database())) tamanho`);
---
<App title="Cópia de segurança" ativo="backup">
  <section class="card stack" style="max-width:680px">
    <p>Base de dados actual: <strong>{n.tamanho}</strong> · {n.p} beneficiários · {n.u} utilizadores · {n.a} entradas de auditoria.</p>
    <p>A cópia descarregada é um ficheiro JSON com todas as tabelas. Em produção, a Netlify DB (Neon) mantém também
      um histórico de restauro automático, gerido na consola da Neon.</p>
    <div class="alerta alerta--aviso">
      Os campos BI, telefone, e-mail e morada seguem encriptados na cópia. Para os ler é necessária a mesma chave
      (<code>APP_SECRET</code>) — guarde-a em local seguro e separado da cópia.
    </div>
    <form method="post"><button class="btn" type="submit">Descarregar cópia (.json)</button></form>
  </section>
</App>
