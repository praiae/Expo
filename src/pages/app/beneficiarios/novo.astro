---
import App from '../../../layouts/App.astro';
import FormBeneficiario from '../../../components/FormBeneficiario.astro';
import { lerFormulario, validarFormulario, biDuplicado, gravarPessoa } from '../../../lib/pessoas.js';

let v = {};
let erros: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  v = lerFormulario(await Astro.request.formData());
  erros = validarFormulario(v);
  const dup = !erros.bi && biDuplicado(v.bi);
  if (dup) erros.bi = `Já existe um registo com este BI (n.º ${dup.id}).`;
  if (!Object.keys(erros).length) {
    const id = gravarPessoa(v, Astro.locals.user);
    return Astro.redirect(`/app/beneficiarios/${id}?ok=criado`);
  }
  Astro.response.status = 422;
}
---
<App title="Novo registo" ativo="novo" subtitulo="Campos com * são obrigatórios. Registos incompletos podem ser gravados e completados mais tarde.">
  <FormBeneficiario v={v} erros={erros} />
</App>
