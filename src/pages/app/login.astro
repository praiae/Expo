---
import Base from '../../layouts/Base.astro';
import A11y from '../../components/A11y.astro';
import { iniciarSessao, COOKIE_SESSAO, opcoesCookie } from '../../lib/auth.js';

// Só aceita redireccionamentos internos para evitar "open redirect".
const destino = (r: string | null) => (r && r.startsWith('/app') && !r.startsWith('//') ? r : '/app');
let erro = '';
let aviso = '';
let email = '';

if (Astro.locals.user) return Astro.redirect(destino(Astro.url.searchParams.get('r')));

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  email = String(fd.get('email') || '');
  const s = await iniciarSessao(email, String(fd.get('password') || ''), Astro.locals.ip);
  if (s?.pendente) {
    aviso = 'A sua conta ainda aguarda aprovação de um administrador. Poderá entrar assim que for aprovada.';
    Astro.response.status = 403;
  } else if (s) {
    Astro.cookies.set(COOKIE_SESSAO, s.token, opcoesCookie(s.expira));
    return Astro.redirect(destino(String(fd.get('r') || '')));
  } else {
    erro = 'E-mail ou palavra-passe incorrectos.';
    Astro.response.status = 401;
  }
}
---
<Base title="Entrar · Expo Connect Angola">
  <main id="conteudo" class="login">
    <div class="topo"><a href="/">← Voltar ao site</a><A11y /></div>
    <div class="card caixa">
      <img class="logo-img" src="/logo.png" alt="Expo Connect Angola" width="64" height="64" />
      <p class="topic">Área reservada</p>
      <h1>Entrar na plataforma</h1>
      <p class="hint">Acesso para técnicos, analistas, gestores e beneficiários registados.</p>
      {erro && <div class="alerta alerta--erro" role="alert">{erro}</div>}
      {aviso && <div class="alerta alerta--aviso" role="alert">{aviso}</div>}
      <form method="post" class="stack">
        <input type="hidden" name="r" value={Astro.url.searchParams.get('r') || ''} />
        <label class="field"><span>E-mail</span><input type="email" name="email" value={email} autocomplete="username" required autofocus /></label>
        <label class="field"><span>Palavra-passe</span><input type="password" name="password" autocomplete="current-password" required /></label>
        <button class="btn" type="submit" style="width:100%">Entrar</button>
      </form>
      <p class="alternativa">Ainda não tem conta? <a href="/app/registo">Criar conta</a></p>
    </div>
  </main>
</Base>

<style>
  /* Centragem vertical que nunca corta o conteúdo quando é mais alto que o ecrã. */
  .login > :first-child { margin-top: auto; } .login > :last-child { margin-bottom: auto; }
  .login { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 2rem 16px; gap: 1.25rem;
    background-image: linear-gradient(to bottom, transparent 40%, var(--bg)),
      repeating-linear-gradient(30deg, var(--border) 0 1px, transparent 1px 60px),
      repeating-linear-gradient(-30deg, var(--border) 0 1px, transparent 1px 60px); }
  .topo { width: min(440px, 100%); display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; font: var(--t-body-2); }
  .topo a { color: var(--text); text-decoration: none; font-weight: 500; }
  .topo a:hover { color: var(--link); }
  .caixa { width: min(440px, 100%); padding: 2.5rem 2rem; box-shadow: 0 30px 60px -30px rgb(20 40 90 / .25); }
  .caixa img { border-radius: var(--radius-md); margin-bottom: 1.5rem; }
  .caixa h1 { font: var(--t-h4); margin: 0 0 .5rem; }
  .caixa .hint { font: var(--t-body-2); color: var(--text-2); }
  form { margin-top: 1.75rem; }
  .alternativa { margin: 1.5rem 0 0; text-align: center; font: var(--t-body-2); color: var(--text-2); }
</style>
