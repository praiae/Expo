---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArtigoCartao from '../../components/ArtigoCartao.astro';
import { artigosPublicados } from '../../lib/artigos.js';

export const prerender = true;

const artigos = await artigosPublicados();
const categorias = [...new Set(artigos.map((a) => a.data.categoria))];
---
<Base title="Blog · Expo Connect Angola" description="Artigos científicos e de divulgação sobre acessibilidade, tecnologias de apoio, dados e inclusão de pessoas com deficiência.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="Expo Connect Angola — Blog" href="/blog/rss.xml" />
  <SiteHeader />
  <main id="conteudo" class="container blog">
    <header class="blog-cab">
      <p class="topic">Blog científico</p>
      <h1 class="blog-tit">Investigação, tecnologia e inclusão</h1>
      <p class="blog-desc">Artigos científicos e de divulgação sobre acessibilidade, tecnologias de apoio, inteligência artificial e dados ao serviço das pessoas com deficiência.</p>
    </header>

    {categorias.length > 1 && (
      <div class="filtro no-print" role="group" aria-label="Filtrar por categoria" hidden data-filtro>
        <button type="button" aria-pressed="true" data-cat="">Todos</button>
        {categorias.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
      </div>
    )}

    {artigos.length === 0 ? <p class="vazio">Ainda não há artigos publicados.</p> : (
      <ul class="grelha" role="list">
        {artigos.map((a) => <li><ArtigoCartao artigo={a} /></li>)}
      </ul>
    )}
    <p class="rss"><a href="/blog/rss.xml">Subscrever por RSS</a></p>
  </main>
  <SiteFooter />
</Base>

<script>
  // Filtro por categoria (melhoria progressiva: sem JS todos os artigos ficam visíveis).
  function filtro() {
    const caixa = document.querySelector<HTMLElement>('[data-filtro]');
    if (!caixa || caixa.dataset.ligado) return;
    caixa.dataset.ligado = '1';
    caixa.hidden = false;
    caixa.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      caixa.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('.grelha > li').forEach((li) => {
        const cat = li.querySelector<HTMLElement>('[data-categoria]')?.dataset.categoria;
        li.hidden = !!b.dataset.cat && cat !== b.dataset.cat;
      });
    });
  }
  filtro();
  document.addEventListener('astro:page-load', filtro);
</script>

<style>
  .blog { padding-top: 5rem; }
  .blog-cab { max-width: 760px; }
  .blog-tit { margin: 0; font: var(--t-h2); font-size: clamp(2rem, 4vw, 3rem); text-wrap: balance; }
  .blog-desc { margin: 1rem 0 0; color: var(--text-2); font-size: 1.0625rem; }
  .filtro { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.5rem; }
  .filtro button { min-height: 40px; padding: 0 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-strong); background: transparent;
    color: var(--text); font: var(--t-body-2); font-weight: 500; cursor: pointer; transition: border-color .2s, color .2s, background-color .2s; }
  .filtro button:hover { border-color: var(--link); color: var(--link); }
  .filtro button[aria-pressed="true"] { background: var(--primary); border-color: var(--primary); color: #fff; }
  .grelha { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .rss { margin: 2rem 0 0; font: var(--t-body-2); }
  @media (max-width: 1100px) { .grelha { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .blog { padding-top: 3rem; } .grelha { grid-template-columns: 1fr; } }
</style>
